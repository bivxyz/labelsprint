function createWorkspaceTemplate_(id, name, category, description, widthIn, heightIn, rows, columns, topIn, leftIn, horizontalGapIn, verticalGapIn, aliases) {
  return Object.freeze({
    id: id,
    name: name,
    category: category,
    description: description,
    widthIn: widthIn,
    heightIn: heightIn,
    rows: rows,
    columns: columns,
    topIn: topIn,
    leftIn: leftIn,
    horizontalGapIn: horizontalGapIn,
    verticalGapIn: verticalGapIn,
    aliases: aliases || [],
    labelsPerSheet: rows * columns
  });
}

function getWorkspaceTemplate_(templateId) {
  const normalized = String(templateId || '').replace(/\D/g, '');
  if (LABELSPRINT_TEMPLATES[normalized]) return LABELSPRINT_TEMPLATES[normalized];

  const ids = Object.keys(LABELSPRINT_TEMPLATES);
  for (let index = 0; index < ids.length; index += 1) {
    const template = LABELSPRINT_TEMPLATES[ids[index]];
    if (template.aliases.indexOf(normalized) >= 0) return template;
  }

  return LABELSPRINT_TEMPLATES['5160'];
}
