    "templates:import": "python tools/avery_template_import.py"
  },
  "dependencies": {
    "@tailwindcss/vite": "^4.1.14",
    "docx": "^8.6.0",
    "jspdf": "^4.2.1",
    "lucide": "^0.468.0",
    "papaparse": "^5.4.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "tailwindcss": "^4.1.14",
    "vite": "^6.2.3"
  }
}
