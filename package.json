{
  "name": "labelsprint-app",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite --configLoader runner --port=3000 --host=0.0.0.0",
    "build": "vite build --configLoader runner",
    "preview": "vite preview --configLoader runner",
    "lint": "npm run templates:check && npm run build",
    "templates:generate": "node tools/generate-template-outputs.mjs",
